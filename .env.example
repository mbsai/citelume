# Only needed to run the public demo mode (e.g. on a Hugging Face Space, set these as Space secrets/variables).
# Local use needs none of this: enter your keys in the app under "API Keys & Sources Setup".
CITELUME_DEMO=1
DEMO_OPENROUTER_API_KEY=
DEMO_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
DEMO_STANDARD_PER_DAY=3
DEMO_DEEP_PER_DAY=1
DEMO_OWN_KEY_PER_DAY=30
DEMO_MAX_CONCURRENT=2
DEMO_PROXY_HOPS=1
# Optional literature-source keys used when a visitor gives none
DEMO_OPENALEX_API_KEY=
DEMO_S2_API_KEY=
DEMO_PUBMED_API_KEY=
